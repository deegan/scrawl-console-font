post_install() {
	fc-cache -f /usr/share/fonts/scrawl-console >/dev/null 2>&1 || true
	cat <<'EOF'
==> scrawl-console-font installed (ScrawlS, ScrawlW).
==> To use it in foot, run:
      scrawl-font-setup-foot           # ScrawlS (8x16 "short")
      scrawl-font-setup-foot ScrawlW   # wide variant
==> Then open a new foot window (existing ones won't hot-reload).
EOF
}

post_upgrade() {
	post_install
}

post_remove() {
	fc-cache -f >/dev/null 2>&1 || true
}
